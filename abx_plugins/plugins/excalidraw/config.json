{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Excalidraw",
  "description": "Save editable Excalidraw scenes and SVG previews with embedded scene data.",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [
    "chrome"
  ],
  "required_binaries": [],
  "output_mimetypes": [
    "application/json",
    "image/svg+xml"
  ],
  "properties": {
    "EXCALIDRAW_ENABLED": {
      "type": "boolean",
      "default": true,
      "description": "Export Excalidraw scenes and SVG previews"
    },
    "EXCALIDRAW_TIMEOUT": {
      "type": "integer",
      "default": 120,
      "minimum": 5,
      "x-fallback": "TIMEOUT",
      "description": "Total export/download timeout in seconds"
    }
  },
  "category": "media",
  "display_order": 206,
  "snapshot_output_group": "embedded_media",
  "default_output_path": "downloads.json",
  "screenshot": "screenshot.json"
}
