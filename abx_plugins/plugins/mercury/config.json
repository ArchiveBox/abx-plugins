{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mercury",
  "description": "Extract article HTML, text, and metadata using the maintained Mercury parser.",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [
    "dom"
  ],
  "wait_for_background_cleanup": true,
  "required_binaries": [
    {
      "name": "{MERCURY_BINARY}",
      "binproviders": "env,npm",
      "min_version": "3.1.2",
      "overrides": {
        "npm": {
          "install_root": "{ABXPKG_LIB_DIR}/npm/packages/mercury",
          "install_args": [
            "@jocmp/mercury-parser@3.1.2"
          ],
          "postinstall_scripts": true,
          "min_release_age": 0
        }
      },
      "min_release_age": 0,
      "max_version": "3.1.2"
    }
  ],
  "output_mimetypes": [
    "text/html",
    "text/plain",
    "application/json"
  ],
  "properties": {
    "MERCURY_ENABLED": {
      "type": "boolean",
      "default": true,
      "x-aliases": [
        "SAVE_MERCURY",
        "USE_MERCURY"
      ],
      "description": "Enable Mercury text extraction"
    },
    "MERCURY_BINARY": {
      "type": "string",
      "default": "mercury-parser",
      "description": "Path to the Mercury parser binary"
    },
    "MERCURY_TIMEOUT": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "x-fallback": "TIMEOUT",
      "description": "Timeout for Mercury in seconds"
    },
    "MERCURY_ARGS": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "x-aliases": [
        "MERCURY_DEFAULT_ARGS"
      ],
      "description": "Default Mercury parser arguments"
    },
    "MERCURY_ARGS_EXTRA": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "x-aliases": [
        "MERCURY_EXTRA_ARGS"
      ],
      "description": "Extra arguments to append to Mercury parser command"
    }
  },
  "category": "text",
  "display_order": 50,
  "snapshot_output_group": "article_text",
  "snapshot_output_order": 2
}
