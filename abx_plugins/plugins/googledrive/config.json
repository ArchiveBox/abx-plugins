{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Drive",
  "description": "Save Google Drive shared folders with the built-in ZIP download using the existing Chrome session.",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [
    "chrome"
  ],
  "required_binaries": [],
  "output_mimetypes": [
    "application/json",
    "application/octet-stream"
  ],
  "properties": {
    "GOOGLEDRIVE_ENABLED": {
      "type": "boolean",
      "default": true,
      "x-aliases": [
        "SAVE_GOOGLEDRIVE",
        "USE_GOOGLEDRIVE"
      ],
      "description": "Download Google Drive shares"
    },
    "GOOGLEDRIVE_TIMEOUT": {
      "type": "integer",
      "default": 120,
      "minimum": 5,
      "x-fallback": "TIMEOUT",
      "description": "Total timeout for provider ZIP preparation and download in seconds"
    }
  },
  "category": "media",
  "display_order": 101,
  "snapshot_output_group": "embedded_media",
  "default_output_path": "downloads.json",
  "screenshot": "screenshot.json"
}
