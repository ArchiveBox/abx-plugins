{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "forum-dl",
  "description": "Download forum threads and exports in JSONL, WARC, and mailbox-style archive formats.",
  "screenshot": "screenshot.json",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [],
  "required_binaries": [
    {
      "name": "{FORUMDL_BINARY}",
      "binproviders": "uv,env",
      "min_version": "0.3.0",
      "max_version": "0.3.0",
      "overrides": {
        "uv": {
          "postinstall_scripts": true,
          "install_args": [
            "--no-deps",
            "forum-dl==0.3.0",
            "chardet==7.7.0",
            "pydantic==2.14.1",
            "pydantic-core==2.50.1",
            "typing-extensions==4.16.0",
            "annotated-types==0.8.0",
            "typing-inspection==0.4.4",
            "beautifulsoup4==4.15.0",
            "soupsieve==3.0.4",
            "lxml==6.1.3",
            "requests==2.34.2",
            "urllib3==2.8.0",
            "certifi==2026.10.19",
            "idna==3.20",
            "charset-normalizer==3.5.2",
            "tenacity==9.2.1",
            "python-dateutil==3.0.0",
            "six==1.17.0",
            "html2text==2025.4.15",
            "warcio==1.8.1",
            "--exclude-newer-package=certifi=2026-10-23T00:00:00Z",
            "--exclude-newer-package=python-dateutil=2026-10-23T00:00:00Z",
            "--exclude-newer-package=soupsieve=2026-10-23T00:00:00Z"
          ],
          "min_release_age": 0,
          "install_root": "{ABXPKG_LIB_DIR}/uv/packages/forum-dl"
        }
      },
      "min_release_age": 0
    }
  ],
  "output_mimetypes": [
    "application/x-ndjson",
    "application/warc",
    "message/rfc822"
  ],
  "properties": {
    "FORUMDL_ENABLED": {
      "type": "boolean",
      "default": true,
      "x-aliases": [
        "SAVE_FORUMDL",
        "USE_FORUMDL"
      ],
      "description": "Enable forum downloading with forum-dl"
    },
    "FORUMDL_BINARY": {
      "type": "string",
      "default": "forum-dl",
      "description": "Path to forum-dl binary"
    },
    "FORUMDL_TIMEOUT": {
      "type": "integer",
      "default": 3600,
      "minimum": 10,
      "x-fallback": "TIMEOUT",
      "description": "Timeout for forum downloads in seconds"
    },
    "FORUMDL_OUTPUT_FORMAT": {
      "type": "string",
      "default": "jsonl",
      "enum": [
        "jsonl",
        "warc",
        "mbox",
        "maildir",
        "mh",
        "mmdf",
        "babyl"
      ],
      "description": "Output format for forum downloads"
    },
    "FORUMDL_ARGS": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "--timeout=5",
        "--retries=0"
      ],
      "x-aliases": [
        "FORUMDL_DEFAULT_ARGS"
      ],
      "description": "Default forum-dl arguments. Keep autodetection deterministic by disabling forum-dl's retry loop unless explicitly overridden."
    },
    "FORUMDL_ARGS_EXTRA": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "x-aliases": [
        "FORUMDL_EXTRA_ARGS"
      ],
      "description": "Extra arguments to append to forum-dl command"
    }
  },
  "category": "text",
  "display_order": 40,
  "snapshot_output_group": "embedded_media",
  "snapshot_display_name": "Forum-DL"
}
