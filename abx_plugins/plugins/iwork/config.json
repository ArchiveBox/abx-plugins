{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iWork",
  "description": "Save public Keynote, Pages and Numbers documents as PDF.",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [
    "chrome"
  ],
  "required_binaries": [],
  "output_mimetypes": [
    "application/json",
    "application/pdf"
  ],
  "properties": {
    "IWORK_ENABLED": {
      "type": "boolean",
      "default": true,
      "description": "Export public iWork documents as PDF"
    },
    "IWORK_TIMEOUT": {
      "type": "integer",
      "default": 120,
      "minimum": 5,
      "x-fallback": "TIMEOUT",
      "description": "Total export/download timeout in seconds"
    }
  },
  "category": "text",
  "display_order": 217,
  "snapshot_output_group": "embedded_media",
  "default_output_path": "downloads.json",
  "screenshot": "screenshot.json"
}
