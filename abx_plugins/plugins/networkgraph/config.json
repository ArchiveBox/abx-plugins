{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Network Graph",
  "description": "Network Graph",
  "type": "object",
  "additionalProperties": false,
  "app_module": "abx_plugins.plugins.networkgraph.app",
  "category": "utilities",
  "required_plugins": [],
  "required_binaries": [],
  "output_mimetypes": [],
  "x-auto-run": false,
  "properties": {
    "NETWORKGRAPH_ENABLED": {
      "type": "boolean",
      "default": true
    },
    "NETWORKGRAPH_MAX_NODES": {
      "type": "integer",
      "default": 1200,
      "minimum": 100,
      "maximum": 3000
    },
    "NETWORKGRAPH_BATCH_SIZE": {
      "type": "integer",
      "default": 16,
      "minimum": 1,
      "maximum": 32
    }
  }
}
