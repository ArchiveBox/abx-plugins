{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "2Captcha Node runtime",
  "type": "object",
  "required_binaries": [
    {
      "name": "{NODE_BINARY}",
      "binproviders": "env,pnpm,apt,brew",
      "min_version": "22.12.0",
      "overrides": {
        "pnpm": {
          "install_root": "{ABXPKG_LIB_DIR}/pnpm/packages/node",
          "install_args": [
            "node@22.23.1"
          ],
          "postinstall_scripts": true
        },
        "apt": {
          "install_args": [
            "nodejs"
          ]
        }
      }
    }
  ],
  "properties": {
    "NODE_BINARY": {
      "type": "string",
      "default": "node",
      "description": "Path to Node.js binary"
    }
  }
}
