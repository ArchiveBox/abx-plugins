# Copy to .env before starting. Relative paths are resolved from this directory.
TLSNOTARY_STATE_DIR=./state
# Listen only on loopback; put an HTTPS reverse proxy or tunnel in front.
TLSNOTARY_PORT=7047
# Serialize proofs within the shipped verifier's 3 GiB container budget.
TLSNOTARY_MAX_SESSIONS=1
# Normal release image; pin its published sha-<commit> tag or digest for upgrades.
TLSNOTARY_GATEWAY_IMAGE=ghcr.io/archivebox/tlsnotary-gateway:latest
# Match the owner of state/signing.pem: use the output of id -u and id -g.
# Matching the UID permits a mode-600 key without granting extra capabilities.
TLSNOTARY_UID=1000
TLSNOTARY_GID=1000
