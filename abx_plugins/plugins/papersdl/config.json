{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "papers-dl",
  "description": "Download academic papers from paper URLs and DOI/arXiv citations linked or mentioned in articles.",
  "screenshot": "screenshot.json",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [],
  "required_binaries": [
    {
      "name": "{PAPERSDL_BINARY}",
      "binproviders": "uv,env",
      "min_version": null,
      "postinstall_scripts": true,
      "overrides": {
        "uv": {
          "postinstall_scripts": true,
          "install_root": "{ABXPKG_LIB_DIR}/uv/packages/papers-dl",
          "install_args": [
            "--no-deps",
            "--only-binary=PyMuPDF",
            "papers-dl==0.0.25",
            "aiohttp==3.14.5",
            "aiohappyeyeballs==2.7.1",
            "aiosignal==1.4.0",
            "attrs==26.1.0",
            "frozenlist==1.8.0",
            "multidict==6.9.1",
            "propcache==0.5.4",
            "typing-extensions==4.16.0",
            "yarl==1.25.1",
            "beautifulsoup4==4.15.0",
            "bs4==0.0.2",
            "certifi==2026.10.19",
            "cffi==2.1.1",
            "charset-normalizer==3.5.2",
            "cryptography==50.0.2",
            "easygui==0.98.3",
            "feedparser==6.0.14",
            "feedparser-sgmllib==2.1.0",
            "google==3.0.0",
            "idna==3.20",
            "loguru==0.7.3",
            "pdf2doi==1.7",
            "pdfminer.six==20260107",
            "pdftitle==0.20",
            "pycparser==3.12",
            "PyMuPDF==1.28.2",
            "PyPDF2==3.0.1",
            "pyperclip==1.11.0",
            "requests==2.34.2",
            "retrying==1.4.2",
            "sgmllib3k==1.0.0",
            "six==1.17.0",
            "soupsieve==3.0.4",
            "urllib3==2.8.0",
            "w3lib==2.5.0",
            "pypdf==6.21.2",
            "python-dotenv==1.2.4",
            "--exclude-newer-package=certifi=2026-10-23T00:00:00Z",
            "--exclude-newer-package=pycparser=2026-10-23T00:00:00Z",
            "--exclude-newer-package=soupsieve=2026-10-23T00:00:00Z",
            "--exclude-newer-package=pypdf=2026-10-23T00:00:00Z"
          ],
          "min_release_age": 0
        }
      },
      "min_release_age": 0
    }
  ],
  "output_mimetypes": [
    "application/pdf"
  ],
  "properties": {
    "PAPERSDL_ENABLED": {
      "type": "boolean",
      "default": true,
      "x-aliases": [
        "SAVE_PAPERSDL",
        "USE_PAPERSDL"
      ],
      "description": "Enable paper downloading with papers-dl"
    },
    "PAPERSDL_BINARY": {
      "type": "string",
      "default": "papers-dl",
      "description": "Path to papers-dl binary"
    },
    "PAPERSDL_TIMEOUT": {
      "type": "integer",
      "default": 300,
      "minimum": 10,
      "x-fallback": "TIMEOUT",
      "description": "Total timeout for article discovery and all paper downloads in seconds"
    },
    "PAPERSDL_ARGS": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "fetch"
      ],
      "x-aliases": [
        "PAPERSDL_DEFAULT_ARGS"
      ],
      "description": "Default papers-dl arguments"
    },
    "PAPERSDL_ARGS_EXTRA": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "x-aliases": [
        "PAPERSDL_EXTRA_ARGS"
      ],
      "description": "Extra arguments to append to papers-dl command"
    },
    "PAPERSDL_UNPAYWALL_EMAIL": {
      "type": "string",
      "default": "unpaywall-papersdl@archivebox.io",
      "x-aliases": [
        "UNPAYWALL_EMAIL"
      ],
      "description": "Contact email sent to the Unpaywall DOI API; empty disables Unpaywall lookup"
    }
  },
  "category": "text",
  "display_order": 90,
  "snapshot_output_group": "embedded_media",
  "snapshot_output_order": 0
}
