{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Podcast Archiver",
  "description": "Download podcast episodes and their metadata from RSS or Atom feeds, including paged feeds.",
  "screenshot": "screenshot.json",
  "type": "object",
  "additionalProperties": false,
  "required_plugins": [],
  "required_binaries": [
    {
      "name": "{PODCAST_ARCHIVER_BINARY}",
      "binproviders": "env,uv",
      "min_version": "2.3.5",
      "max_version": "2.3.5",
      "overrides": {"uv": {"install_args": ["podcast-archiver==2.3.5"], "min_release_age": 0, "postinstall_scripts": true}}
    }
  ],
  "category": "media",
  "snapshot_output_group": "embedded_media",
  "snapshot_display_name": "Podcast",
  "x-auto-run": false,
  "output_mimetypes": ["audio/", "video/", "application/json"],
  "properties": {
    "PODCAST_ARCHIVER_ENABLED": {"type": "boolean", "default": true, "description": "Download episodes from podcast feeds"},
    "PODCAST_ARCHIVER_BINARY": {"type": "string", "default": "podcast-archiver", "description": "Path to podcast-archiver"},
    "PODCAST_ARCHIVER_TIMEOUT": {"type": "integer", "default": 600, "minimum": 1, "x-fallback": "TIMEOUT", "description": "Maximum download time in seconds"},
    "PODCAST_ARCHIVER_MAX_EPISODES": {"type": "integer", "default": 0, "minimum": 0, "description": "Maximum episodes to download; 0 downloads all episodes"}
  }
}
