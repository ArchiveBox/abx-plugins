    <meta name="twitter:title" content="ArchiveBox Plugin Marketplace">
    <meta name="twitter:description" content="ArchiveBox-compatible plugin suite (hooks and config schemas). This package contains standalone plugin hook scripts and config schemas.">
    <meta name="twitter:image" content="https://plugins.archivebox.io/assets/social-card.png">
    <meta name="twitter:image:alt" content="ArchiveBox Plugin Marketplace. ArchiveBox-compatible plugin suite (hooks and config schemas). This package contains standalone plugin hook scripts and config schemas.">
    <link rel="icon" type="image/x-icon" href="https://plugins.archivebox.io/assets/favicon.ico">
    <link rel="icon" type="image/png" sizes="192x192" href="https://plugins.archivebox.io/assets/icon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://plugins.archivebox.io/assets/apple-touch-icon.png">
    <link rel="stylesheet" href="css/tokens.css?v=1">
    <link rel="stylesheet" href="css/base.css?v=1">
    <link rel="stylesheet" href="css/components.css?v=1">
    <style>
      body {
        font-family: var(--ab-font-sans);
      }

      .hero {
        padding: var(--ab-s-5) 0 var(--ab-s-5);
        border-bottom: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
      }

      .hero .ab-container {
        max-width: none;
      }

      .hero__layout {
        display: grid;
        grid-template-columns: minmax(380px, 0.9fr) minmax(520px, 1.1fr);
        gap: var(--ab-s-6);
        align-items: start;
      }

      .hero__intro {
        max-width: 760px;
      }

      .hero__title {
        font-size: var(--ab-size-2xl);
        line-height: 1.12;
        letter-spacing: 0;
        font-weight: 700;
        margin: 0;
        max-width: 720px;
      }

      .hero__copy {
        margin-top: var(--ab-s-3);
        max-width: 72ch;
        font-family: var(--ab-font-sans);
        font-size: var(--ab-size-md);
        line-height: 1.55;
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ab-s-3);
        margin-top: var(--ab-s-4);
      }

      .hero__product-actions {
        --ab-brand-red: #b4232a;
        --ab-brand-red-hover: #951b22;
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: var(--ab-s-3);
        margin-top: var(--ab-s-5);
        max-width: 560px;
      }

      .product-cta {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: var(--ab-s-3) var(--ab-s-4);
        border: 1px solid var(--ab-brand-red);
        border-radius: var(--ab-r-3);
        background: var(--ab-brand-red);
        color: #fff;
        text-decoration: none;
      }

      .product-cta:hover {
        background: var(--ab-brand-red-hover);
        border-color: var(--ab-brand-red-hover);
        color: #fff;
      }

      .product-cta strong {
        color: inherit;
        font-size: var(--ab-size-base);
        line-height: 1.2;
      }

      .product-cta span {
        color: rgba(255, 255, 255, .82);
        font-size: var(--ab-size-xs);
        line-height: 1.35;
      }

      .hero__support {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: var(--ab-s-3);
      }

      .hero__support code {
        font-size: 11px;
        padding: 4px 8px;
        background: var(--ab-bg-sunken);
        border: 1px solid var(--ab-rule);
        border-radius: var(--ab-r-2);
      }

      .hero__workflow {
        counter-reset: workflow;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--ab-s-3);
        margin-top: var(--ab-s-5);
        padding: 0;
        list-style: none;
      }

      .workflow-step {
        border: 1px solid var(--ab-rule);
        border-radius: var(--ab-r-3);
        background: var(--ab-bg);
        padding: var(--ab-s-3) var(--ab-s-4);
        counter-increment: workflow;
      }

      .workflow-step strong {
        display: flex;
        align-items: center;
        gap: var(--ab-s-2);
        margin-bottom: 4px;
        color: var(--ab-fg);
      }

      .workflow-step strong::before {
        content: counter(workflow);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: var(--ab-r-pill);
        background: var(--ab-accent-wash);
        color: var(--ab-accent);
        font-family: var(--ab-font-mono);
        font-size: 10px;
      }

      .workflow-step span {
        display: block;
        color: var(--ab-fg-muted);
        font-size: var(--ab-size-sm);
        line-height: 1.45;
      }

      .hero__quickstart {
        min-width: 0;
      }

      .plugin-stack {
        display: grid;
        grid-template-columns: repeat(5, 54px);
        justify-content: center;
        gap: 12px 0;
        margin: 0 0 12px auto;
        width: fit-content;
        padding: 12px 20px 12px 0;
        list-style: none;
      }

      .plugin-stack li:nth-child(4n + 1) { --tilt: -10deg; }
      .plugin-stack li:nth-child(4n + 2) { --tilt: 6deg; }
      .plugin-stack li:nth-child(4n + 3) { --tilt: -5deg; }
      .plugin-stack li:nth-child(4n) { --tilt: 10deg; }

      .plugin-stack a {
        position: relative;
        display: grid;
        width: 68px;
        height: 68px;
        place-items: center;
        border: 1px solid hsl(339 7% 94%);
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 7px 18px #21192114;
        transform: rotate(var(--tilt));
      }

      .plugin-stack li:nth-child(n + 6) a {
        left: 12px;
      }

      .plugin-stack a:hover,
      .plugin-stack a:focus-visible {
        z-index: 1;
        outline: 2px solid #9b2854;
        outline-offset: 3px;
        transform: translateY(-4px);
      }

      .plugin-stack img {
        width: 44px;
        height: 44px;
        object-fit: contain;
      }

      @media (max-width: 980px) {
        .plugin-stack {
          grid-template-columns: repeat(10, 26px);
          justify-content: start;
          padding: 10px 0 16px;
          margin-left: 0;
        }

        .plugin-stack a {
          width: 44px;
          height: 44px;
          border-radius: 12px;
        }

        .plugin-stack li:nth-child(n + 6) a {
          left: 0;
        }

        .plugin-stack img {
          width: 28px;
          height: 28px;
        }
      }

      .hero-example {
        border: 1px solid var(--ab-rule-strong);
        border-radius: var(--ab-r-3);
        background: var(--ab-bg-elev);
        overflow: hidden;
      }

      .hero-example-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--ab-s-4);
        padding: var(--ab-s-4);
        border-bottom: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
      }

      .hero-example-title {
        margin: 0;
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-base);
        letter-spacing: 0;
        color: var(--ab-fg);
      }

      .hero-example-copy {
        margin: 6px 0 0;
        max-width: 50ch;
        font-size: var(--ab-size-sm);
      }

      .hero-runner-links {
        display: flex;
        align-items: center;
        gap: var(--ab-s-2);
        flex-wrap: wrap;
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-muted);
      }

      .runner-link {
        text-decoration: none;
      }

      .hero-code-block {
        padding: var(--ab-s-4);
      }

      .hero-code-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--ab-s-3);
        margin-bottom: var(--ab-s-3);
      }

      .hero-code-meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ab-s-2);
        align-items: center;
      }

      .hero-code-kicker {
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0;
        color: var(--ab-fg-muted);
      }

      .copy-button,
      .run-tab {
        appearance: none;
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
        color: var(--ab-fg);
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0;
        padding: 8px 12px;
        cursor: pointer;
        border-radius: var(--ab-r-2);
      }

      .copy-button:hover,
      .run-tab:hover {
        background: var(--ab-bg-sunken);
      }

      .hero-code-block .ab-terminal {
        box-shadow: none;
      }

      .hero-code-block .ab-terminal__bar {
        display: none;
      }

      .hero-code-block .ab-terminal__body pre {
        font-size: var(--ab-size-sm);
        line-height: 1.55;
      }

      .install-details {
        padding: 0 var(--ab-s-4) var(--ab-s-4);
      }

      .install-details summary {
        cursor: pointer;
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0;
        color: var(--ab-fg-muted);
      }

      .install-details pre {
        margin-top: var(--ab-s-3);
      }

      .install-details .ab-terminal {
        margin-top: var(--ab-s-3);
        box-shadow: none;
      }

      .catalog-toolbar {
        padding: var(--ab-s-4) 0;
        border-bottom: 1px solid var(--ab-rule);
        position: sticky;
        top: 57px;
        z-index: 10;
        background: color-mix(in srgb, var(--ab-bg) 92%, transparent);
        backdrop-filter: blur(10px);
      }

      .catalog-toolbar .ab-container,
      .catalog .ab-container {
        max-width: none;
      }

      .catalog-toolbar__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--ab-s-3);
        align-items: end;
      }

      .searchbox {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .searchbox__control {
        position: relative;
      }

      .searchbox__control input {
        padding-left: 38px;
        font-family: var(--ab-font-mono);
      }

      .searchbox__control svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ab-fg-faint);
      }

      .result-count {
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-muted);
        white-space: nowrap;
        padding-bottom: 8px;
      }

      .catalog {
        padding: var(--ab-s-5) 0 var(--ab-s-6);
      }

      .catalog__head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: var(--ab-s-4);
        margin-bottom: var(--ab-s-5);
      }

      .catalog__head h2 {
        margin: 0;
      }

      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: var(--ab-s-4);
      }

      .plugin-card {
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-elev);
        border-radius: var(--ab-r-3);
        box-shadow: none;
        overflow: hidden;
      }

      .plugin-card summary {
        list-style: none;
        cursor: pointer;
      }

      .plugin-card summary::-webkit-details-marker {
        display: none;
      }

      .plugin-card summary:hover .plugin-card__frame,
      .plugin-card.modal-active .plugin-card__frame {
        border-color: var(--ab-accent);
        box-shadow: none;
        background: color-mix(in srgb, var(--ab-accent-wash) 45%, var(--ab-bg-elev));
      }

      .plugin-card__frame {
        display: block;
        padding: var(--ab-s-4);
        border: 1px solid transparent;
        transition: border-color var(--ab-dur-2) var(--ab-ease), background var(--ab-dur-2) var(--ab-ease);
      }

      .plugin-main h2 {
        margin: 0;
        font-size: var(--ab-size-lg);
        line-height: 1.25;
      }

      .plugin-title-row {
        display: flex;
        align-items: baseline;
        gap: var(--ab-s-3);
        flex-wrap: wrap;
      }

      .plugin-slug {
        margin-top: 6px;
        color: var(--ab-fg-muted);
      }

      .plugin-summary-description {
        margin: var(--ab-s-3) 0 0;
        font-size: var(--ab-size-sm);
      }

      .plugin-subline,
      .plugin-summary-facts,
      .hook-card-chips,
      .pill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .plugin-subline {
        margin-top: var(--ab-s-4);
      }

      .plugin-summary-facts {
        margin-top: var(--ab-s-4);
      }

      .plugin-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-sunken);
        color: var(--ab-accent);
        padding: 10px;
        border-radius: var(--ab-r-2);
      }

      .plugin-icon svg,
      .plugin-icon .abx-output-icon,
      .plugin-icon .abx-output-icon svg {
        display: block;
        width: 100%;
        height: 100%;
      }

      .plugin-order {
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
        color: var(--ab-fg-faint);
      }

      .plugin-language {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
        color: var(--ab-fg-muted);
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 22px;
        padding: 3px 9px;
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
        font-family: var(--ab-font-mono);
        font-size: 10px;
        color: var(--ab-ink-2);
        letter-spacing: 0;
        border-radius: var(--ab-r-2);
      }

      .chip small {
        font-size: inherit;
        color: var(--ab-fg-muted);
      }

      .chip--link {
        text-decoration: none;
      }

      .chip--mime-html,
      .chip--mime-text,
      .chip--mime-doc {
        background: var(--ab-accent-wash);
      }

      .chip--mime-media {
        background: color-mix(in srgb, var(--ab-ochre) 14%, var(--ab-bg-elev));
      }

      .chip--mime-data,
      .chip--mime-code,
      .chip--mime-archive,
      .chip--mime-binary {
        background: color-mix(in srgb, var(--ab-slate) 12%, var(--ab-bg-elev));
      }

      .chip--bg-daemon {
        border-color: color-mix(in srgb, var(--ab-ochre) 32%, transparent);
        color: var(--ab-ochre);
      }

      .chip--bg-finite {
        border-color: color-mix(in srgb, var(--ab-moss) 32%, transparent);
        color: var(--ab-moss);
      }

      .chip--fg {
        border-color: color-mix(in srgb, var(--ab-slate) 32%, transparent);
        color: var(--ab-slate);
      }

      .plugin-body {
        padding: var(--ab-s-4);
      }

      .plugin-body > * + * {
        margin-top: 12px;
      }

      .plugin-screenshots {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .plugin-screenshots img {
        display: block;
        width: 100%;
        height: 120px;
        object-fit: contain;
        object-position: top;
      }

      .plugin-modal-description {
        margin: 0;
        font-size: var(--ab-size-base);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ab-s-3);
      }

      .section-title {
        margin: 0;
        padding-top: var(--ab-s-3);
        border-top: 1px solid var(--ab-rule);
      }

      .plugin-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--ab-s-4);
      }

      .plugin-info-card {
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
        border-radius: var(--ab-r-3);
        padding: var(--ab-s-4);
      }

      .plugin-info-card > span:first-child,
      .hook-card-file,
      .footer-card-subtitle {
        display: block;
        margin-bottom: var(--ab-s-3);
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0;
        color: var(--ab-fg-muted);
      }

      .run-tabs {
        border: 1px solid var(--ab-rule-strong);
        border-radius: var(--ab-r-3);
        overflow: hidden;
      }

      .run-tabs-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        border-bottom: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
      }

      .run-tab {
        border-width: 0 1px 0 0;
        background: transparent;
      }

      .run-tab.active {
        background: var(--ab-bg-elev);
        color: var(--ab-accent);
      }

      .run-tab-panel {
        display: none;
        border: 0;
        margin: 0;
        padding: var(--ab-s-4);
        background: #111827;
        color: #dbe5ef;
        overflow-x: auto;
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-sm);
        line-height: 1.7;
      }

      .run-tab-panel.active {
        display: block;
      }

      .note {
        margin: 0;
        color: var(--ab-fg-muted);
      }

      .hook-list {
        display: grid;
        gap: var(--ab-s-3);
      }

      .hook-card {
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-sunken);
        border-radius: var(--ab-r-3);
        padding: var(--ab-s-4);
      }

      .hook-card-phase {
        margin-left: auto;
        font-family: var(--ab-font-label);
        font-size: var(--ab-size-xs);
        letter-spacing: 0;
        color: var(--ab-accent);
      }

      .config-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--ab-rule);
      }

      .config-table,
      .field-table,
      .env-table {
        width: 100%;
      }

      .config-key-desc {
        display: block;
        margin-top: 6px;
        font-size: var(--ab-size-sm);
        color: var(--ab-fg-muted);
      }

      .cfg-default {
        font-family: var(--ab-font-mono);
        font-size: var(--ab-size-xs);
      }

      .cfg-array,
      .cfg-obj {
        display: grid;
        gap: 4px;
        margin: 4px 0 4px 12px;
      }

      .cfg-obj-key,
      .cfg-bracket {
        color: var(--ab-fg-muted);
      }

      .cfg-string {
        color: var(--ab-accent);
      }

      .cfg-number {
        color: var(--ab-slate);
      }

      .cfg-bool-true {
        color: var(--ab-moss);
      }

      .cfg-bool-false,
      .cfg-null {
        color: var(--ab-ochre);
      }

      .config-table-muted {
        color: var(--ab-fg-faint);
      }

      .empty-state {
        padding: var(--ab-s-6);
        text-align: center;
        border: 1px dashed var(--ab-rule-strong);
        color: var(--ab-fg-muted);
        background: var(--ab-bg-elev);
      }

      .page-footer {
        padding: var(--ab-s-8) 0 var(--ab-s-7);
        border-top: 1px solid var(--ab-rule-strong);
        background: var(--ab-bg-sunken);
      }

      .footer-intro {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: var(--ab-s-6);
        align-items: start;
        margin-bottom: var(--ab-s-6);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--ab-s-4);
      }

      .footer-card {
        border: 1px solid var(--ab-rule);
        background: var(--ab-bg-elev);
        border-radius: var(--ab-r-3);
        padding: var(--ab-s-5);
      }

      .footer-link-list {
        display: grid;
        gap: var(--ab-s-2);
      }

      .footer-link-item {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr);
        gap: var(--ab-s-3);
        padding: var(--ab-s-3) 0;
        border-top: 1px dashed var(--ab-rule);
        text-decoration: none;
      }

      .footer-link-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 22px;
