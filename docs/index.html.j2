    <meta property="og:type" content="website">
    <meta property="og:site_name" content="abx-plugins">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="https://plugins.archivebox.io/">
    <meta property="og:title" content="ArchiveBox Plugin Marketplace">
    <meta property="og:description" content="ArchiveBox-compatible plugin suite (hooks and config schemas). This package contains standalone plugin hook scripts and config schemas.">
    <meta property="og:image" content="https://plugins.archivebox.io/assets/social-card.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
